<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.expensetracker.SignupController"
           prefWidth="1100" prefHeight="780"
           styleClass="root-pane">

    <!-- Background layer -->
    <Pane styleClass="bg-layer"/>

    <!-- Decorative circles -->
    <Pane mouseTransparent="true">
        <Circle styleClass="deco-circle-large"  centerX="100" centerY="150" radius="180"/>
        <Circle styleClass="deco-circle-small"  centerX="990" centerY="600" radius="120"/>
        <Circle styleClass="deco-circle-accent" centerX="940" centerY="70"  radius="60"/>
    </Pane>

    <!-- Main Content -->
    <HBox alignment="CENTER" spacing="0">

        <!-- LEFT PANEL -->
        <VBox styleClass="left-panel" alignment="CENTER" spacing="24"
              prefWidth="440" maxWidth="440">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

            <StackPane styleClass="logo-container">
                <Label text="⬡" styleClass="logo-icon"/>
            </StackPane>

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="FinanceOS"             styleClass="brand-title"/>
                <Label text="Your money, your control." styleClass="brand-tagline"/>
            </VBox>

            <VBox spacing="18" alignment="CENTER_LEFT">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="✦" styleClass="feature-bullet"/>
                    <Label text="Set up in under 2 minutes"          styleClass="feature-text"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="✦" styleClass="feature-bullet"/>
                    <Label text="Customisable budget categories"      styleClass="feature-text"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="✦" styleClass="feature-bullet"/>
                    <Label text="Instant overspend notifications"     styleClass="feature-text"/>
                </HBox>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="71%"  styleClass="stat-value"/>
                    <Label text="Goal hit rate"    styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="Free" styleClass="stat-value"/>
                    <Label text="Always free tier" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- RIGHT PANEL — Signup Form -->
        <VBox styleClass="form-card" alignment="TOP_LEFT" spacing="0"
              prefWidth="440" maxWidth="440">
            <padding><Insets top="44" right="52" bottom="44" left="52"/></padding>

            <Label text="Create account"                              styleClass="form-title"/>
            <Label text="Join thousands of users tracking smarter"   styleClass="form-subtitle"/>

            <Region prefHeight="28"/>

            <Label text="Full name" styleClass="field-label"/>
            <Region prefHeight="8"/>
            <TextField fx:id="fullNameField" promptText="Jane Doe" styleClass="input-field"/>

            <Region prefHeight="18"/>

            <Label text="Email address" styleClass="field-label"/>
            <Region prefHeight="8"/>
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field"/>

            <Region prefHeight="18"/>

            <Label text="Password" styleClass="field-label"/>
            <Region prefHeight="8"/>
            <PasswordField fx:id="passwordField" promptText="Minimum 8 characters" styleClass="input-field"/>

            <Region prefHeight="18"/>

            <Label text="Confirm password" styleClass="field-label"/>
            <Region prefHeight="8"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password" styleClass="input-field"/>

            <Region prefHeight="16"/>

            <CheckBox fx:id="termsCheck"
                      text="I agree to the Terms of Service and Privacy Policy"
                      styleClass="check-box-custom" wrapText="true"/>

            <Region prefHeight="20"/>

            <Label fx:id="errorLabel" text="" styleClass="error-label"
                   wrapText="true" visible="false" managed="false"/>
            <Region fx:id="errorSpacer" prefHeight="0"/>

            <Button fx:id="signupButton" text="Create Account"
                    styleClass="primary-button" maxWidth="Infinity"
                    onAction="#handleSignup"/>

            <Region prefHeight="20"/>

            <HBox alignment="CENTER" spacing="12">
                <Region HBox.hgrow="ALWAYS" styleClass="divider-line"/>
                <Label text="or" styleClass="divider-text"/>
                <Region HBox.hgrow="ALWAYS" styleClass="divider-line"/>
            </HBox>

            <Region prefHeight="16"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Already have an account?" styleClass="switch-text"/>
                <Hyperlink text="Sign in" styleClass="switch-link" onAction="#handleGoToLogin"/>
            </HBox>

        </VBox>
    </HBox>
</StackPane>