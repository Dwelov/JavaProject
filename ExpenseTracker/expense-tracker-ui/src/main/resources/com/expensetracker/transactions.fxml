<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensetracker.TransactionsController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-pane">

    <!-- ═══════════════  SIDEBAR  ═══════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="30">
            <padding><Insets top="40" right="20" bottom="40" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="logo-container-small">
                    <Label text="⬡" styleClass="logo-icon-small"/>
                </StackPane>
                <Label text="FinanceOS" styleClass="brand-title-small"/>
            </HBox>

            <Region prefHeight="20"/>

            <VBox spacing="10">
                <Button text="🏠  Dashboard"    styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavDashboard"/>
                <Button text="↕  Transactions"  styleClass="nav-button, nav-button-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="🏷  Categories"   styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavCategories"/>
                <Button text="📊  Analytics"    styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavAnalytics"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" styleClass="user-profile-card">
                <Label text="Rahib" styleClass="user-name"/>
                <Label text="Free Plan" styleClass="user-plan"/>
                <Button text="Log Out" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════  MAIN CONTENT  ═══════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
            <VBox spacing="24" styleClass="main-content">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <!-- Page header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="4">
                        <Label text="Transactions" styleClass="page-title"/>
                        <Label text="View and manage all your income and expenses." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Add Transaction" styleClass="primary-button" onAction="#handleAddTransaction"/>
                </HBox>

                <!-- Search + Filter bar -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="🔍  Search transactions…"
                               styleClass="input-field" prefWidth="320" HBox.hgrow="NEVER"
                               onKeyReleased="#handleSearch"/>

                    <ComboBox fx:id="categoryFilter" promptText="All Categories"
                              styleClass="combo-box-custom" prefWidth="180"
                              onAction="#handleFilter"/>

                    <ComboBox fx:id="typeFilter" promptText="All Types"
                              styleClass="combo-box-custom" prefWidth="140"
                              onAction="#handleFilter"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="summaryLabel" styleClass="page-subtitle"/>
                </HBox>

                <!-- Table header -->
                <VBox styleClass="dashboard-card" spacing="0">
                    <!-- Column headings -->
                    <HBox styleClass="table-header-row" spacing="0">
                        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                        <Label text="Title"    prefWidth="230" styleClass="table-header-cell"/>
                        <Label text="Category" prefWidth="160" styleClass="table-header-cell"/>
                        <Label text="Date"     prefWidth="130" styleClass="table-header-cell"/>
                        <Label text="Type"     prefWidth="100" styleClass="table-header-cell"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Amount"   prefWidth="120" styleClass="table-header-cell" style="-fx-alignment: CENTER_RIGHT;"/>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.06);"/>

                    <!-- Rows container -->
                    <VBox fx:id="transactionsContainer" spacing="2">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </VBox>

                    <!-- Empty state -->
                    <Label fx:id="emptyLabel" text="No transactions found."
                           styleClass="page-subtitle"
                           visible="false" managed="false"
                           style="-fx-padding: 30; -fx-alignment: CENTER; -fx-max-width: Infinity;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>