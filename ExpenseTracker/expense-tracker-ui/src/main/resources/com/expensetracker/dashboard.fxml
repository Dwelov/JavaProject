<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensetracker.DashboardController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-pane">

    <!-- ═══════════════  SIDEBAR  ═══════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="30">
            <padding><Insets top="40" right="20" bottom="40" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="logo-container-small">
                    <Label text="⬡" styleClass="logo-icon-small"/>
                </StackPane>
                <Label text="FinanceOS" styleClass="brand-title-small"/>
            </HBox>

            <Region prefHeight="20"/>

            <VBox spacing="10">
                <Button text="🏠  Dashboard"   styleClass="nav-button, nav-button-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="↕  Transactions" styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavTransactions"/>
                <Button text="🏷  Categories"  styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavCategories"/>
                <Button text="📊  Analytics"   styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavAnalytics"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" styleClass="user-profile-card">
                <Label text="Rahib" styleClass="user-name"/>
                <Label text="Free Plan" styleClass="user-plan"/>
                <Button text="Log Out" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════  MAIN CONTENT  ═══════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
            <VBox spacing="30" styleClass="main-content">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="My Dashboard" styleClass="page-title"/>
                        <Label text="Welcome back, here is your financial overview." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="monthSelector" styleClass="combo-box-custom" promptText="May 2026"/>
                </HBox>

                <!-- Summary cards (fx:id wired to live data) -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Total Balance" styleClass="card-title"/>
                        <Label fx:id="balanceLabel" text="Rs —" styleClass="card-value-primary"/>
                    </VBox>
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Total Income" styleClass="card-title"/>
                        <Label fx:id="incomeLabel" text="+Rs —" styleClass="card-value-success"/>
                    </VBox>
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Total Expense" styleClass="card-title"/>
                        <Label fx:id="expenseLabel" text="-Rs —" styleClass="card-value-danger"/>
                    </VBox>
                </HBox>

                <!-- Charts + recent transactions -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="15" prefWidth="580">
                        <Label text="Weekly Spending" styleClass="section-title"/>
                        <BarChart fx:id="statisticsChart" legendVisible="false" verticalGridLinesVisible="false">
                            <xAxis>
                                <CategoryAxis fx:id="xAxis" tickLabelFill="#8ca59b"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis tickLabelFill="#8ca59b"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox styleClass="dashboard-card" prefWidth="340" spacing="15">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent Transactions" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Hyperlink fx:id="seeAllLink" text="See All →" styleClass="see-all-link" onAction="#handleSeeAll"/>
                        </HBox>
                        <VBox fx:id="transactionsList" spacing="12"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>