<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensetracker.AnalyticsController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-pane">

    <!-- ═══════════════  SIDEBAR  ═══════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="30">
            <padding><Insets top="40" right="20" bottom="40" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="logo-container-small">
                    <Label text="⬡" styleClass="logo-icon-small"/>
                </StackPane>
                <Label text="FinanceOS" styleClass="brand-title-small"/>
            </HBox>

            <Region prefHeight="20"/>

            <VBox spacing="10">
                <Button text="🏠  Dashboard"   styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavDashboard"/>
                <Button text="↕  Transactions" styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavTransactions"/>
                <Button text="🏷  Categories"  styleClass="nav-button"        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavCategories"/>
                <Button text="📊  Analytics"   styleClass="nav-button, nav-button-active" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" styleClass="user-profile-card">
                <Label fx:id="userNameLabel" text="Rahib" styleClass="user-name"/>
                <Label text="Free Plan" styleClass="user-plan"/>
                <Button text="Log Out" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════  MAIN CONTENT  ═══════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
            <VBox spacing="24" styleClass="main-content">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <!-- Page header -->
                <VBox spacing="4">
                    <Label text="Analytics" styleClass="page-title"/>
                    <Label text="Visualise your spending patterns and financial health." styleClass="page-subtitle"/>
                </VBox>

                <!-- Top summary cards -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Total Income" styleClass="card-title"/>
                        <Label fx:id="totalIncomeLabel" text="Rs 0" styleClass="card-value-success"/>
                    </VBox>
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Total Expenses" styleClass="card-title"/>
                        <Label fx:id="totalExpenseLabel" text="Rs 0" styleClass="card-value-danger"/>
                    </VBox>
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Net Balance" styleClass="card-title"/>
                        <Label fx:id="netBalanceLabel" text="Rs 0" styleClass="card-value-primary"/>
                    </VBox>
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Savings Rate" styleClass="card-title"/>
                        <Label fx:id="savingsRateLabel" text="0%" styleClass="card-value-success"/>
                    </VBox>
                </HBox>

                <!-- Charts row -->
                <HBox spacing="20" alignment="TOP_CENTER">
                    <!-- Weekly bar chart -->
                    <VBox styleClass="dashboard-card" spacing="12" prefWidth="600" maxWidth="800" HBox.hgrow="SOMETIMES">
                        <Label text="Weekly Spending" styleClass="section-title"/>
                        <BarChart fx:id="weeklyChart" legendVisible="false"
                                  verticalGridLinesVisible="true" horizontalGridLinesVisible="false"
                                  prefHeight="320" categoryGap="20" barGap="5">
                            <xAxis>
                                <NumberAxis tickLabelFill="#8ca59b"/>
                            </xAxis>
                            <yAxis>
                                <CategoryAxis fx:id="weekAxis" tickLabelFill="#8ca59b"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Pie chart -->
                    <VBox styleClass="dashboard-card" prefWidth="420" maxWidth="500" spacing="12" HBox.hgrow="SOMETIMES">
                        <Label text="Spending by Category" styleClass="section-title"/>
                        <PieChart fx:id="categoryPieChart" prefHeight="320" legendVisible="false"/>
                    </VBox>
                </HBox>

                <!-- Category breakdown table -->
                <VBox styleClass="dashboard-card" spacing="14">
                    <Label text="Category Breakdown" styleClass="section-title"/>

                    <!-- Header row -->
                    <HBox style="-fx-padding: 0 4 0 4;">
                        <Label text="Category" prefWidth="220"
                               style="-fx-text-fill: #8ca59b; -fx-font-family: 'Trebuchet MS'; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Transactions" prefWidth="120"
                               style="-fx-text-fill: #8ca59b; -fx-font-family: 'Trebuchet MS'; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Total Spent" prefWidth="150"
                               style="-fx-text-fill: #8ca59b; -fx-font-family: 'Trebuchet MS'; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Expenses  (%)"
                               style="-fx-text-fill: #8ca59b; -fx-font-family: 'Trebuchet MS'; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>

                    <Separator style="-fx-background-color: rgba(255,255,255,0.06);"/>

                    <VBox fx:id="categoryBreakdownList" spacing="8"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>